# ==============================================================================
# Git Ignore Configuration for Next.js App Router (TypeScript + Tailwind + daisyUI)
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
/.next/
/out/
/build
/dist
.turbo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage
/.nyc_output
junit.xml
test-results/

# Production Environment & Secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Vercel Deployment Tooling
.vercel

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.sublime-project
*.sublime-workspace

# Temporary / Scratch Files
*.tmp
*.bak
*.swp
.eslintcache
.stylelintcache
